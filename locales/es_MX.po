#: inc/checkdatabasecommand.class.php:42
msgid "Check database to detect inconsistencies."
msgstr "Verificar la base de datos para detectar inconsistencias."

#: inc/checkdatabasecommand.class.php:44
msgid "This command will check database to detect following inconsistencies:"
msgstr "Este comando verificará la base de datos para detectar las siguientes inconsistencias:"

#: inc/checkdatabasecommand.class.php:47
#, php-format
msgid ""
"- some deleted fields may still be present in database (bug introduced in "
"version %s and fixed in version %s)"
msgstr "- algunos campos eliminados aún pueden estar presentes en la base de datos (error introducido en %sy corregido en la versión %s)"

#: inc/checkdatabasecommand.class.php:52
msgid ""
"- container/item type pairs with no matching table, or tables with no "
"matching container/item type pair"
msgstr "- pares contenedor/tipo de elemento sin tabla correspondiente, o tablas sin par contenedor/tipo de elemento correspondiente"

#: inc/checkdatabasecommand.class.php:59
msgid "Use this option to actually fix database"
msgstr "Usa esta opción para arreglar la base de datos"

#: inc/checkdatabasecommand.class.php:75
msgid "Everything is in order - no action needed."
msgstr "Todo está en orden, no se necesita ninguna acción."

#: inc/checkdatabasecommand.class.php:83
#, php-format
msgid ""
"Database was containing orphaned data from %s improperly deleted field(s)."
msgstr "La base de datos contenía datos huérfanos de %s campo(s) eliminados incorrectamente."

#: inc/checkdatabasecommand.class.php:84
#, php-format
msgid "Database contains orphaned data from %s improperly deleted field(s)."
msgstr "La base de datos contiene datos huérfanos de %s campo(s) eliminados de manera incorrecta. "

#: inc/checkdatabasecommand.class.php:90
#, php-format
msgid "-> \"%s.%s\" has been deleted."
msgstr "-> \"%s.%s\" ha sido eliminado."

#: inc/checkdatabasecommand.class.php:91
#, php-format
msgid "-> \"%s.%s\" should be deleted."
msgstr "-> \"%s.%s\" debe eliminarse."

#: inc/checkdatabasecommand.class.php:100
#, php-format
msgid "Run \"%s\" to fix database inconsistencies."
msgstr "Ejecute \"%s\" para corregir las inconsistencias de la base de datos."

#: inc/checkdatabasecommand.class.php:112
#, php-format
msgid "%d container/item type pair(s) have no matching table."
msgstr "%d par(es) contenedor/tipo de elemento no tienen tabla correspondiente."

#: inc/checkdatabasecommand.class.php:117
#, php-format
msgid "-> container #%d (%s): expected table \"%s\" not found"
msgstr "-> contenedor #%d (%s): no se encontró la tabla esperada \"%s\""

#: inc/checkdatabasecommand.class.php:127
#, php-format
msgid "%d table(s) do not match any container/item type pair."
msgstr "%d tabla(s) no coinciden con ningún par contenedor/tipo de elemento."

